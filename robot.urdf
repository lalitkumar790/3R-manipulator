<?xml version="1.0"?>
<robot name="three_r_manipulator">
<link name="base_link"><visual><geometry><mesh filename="package://three_r_sim/meshes/base_ring.stl" scale=".001 .001 .001"/></geometry></visual></link>
<link name="link1"><visual><geometry><mesh filename="package://three_r_sim/meshes/link1.stl" scale=".001 .001 .001"/></geometry></visual><inertial><origin xyz=".065 0 .004"/><mass value=".20"/><inertia ixx=".0007" ixy="0" ixz="0" iyy=".0007" iyz="0" izz=".0002"/></inertial></link>
<link name="link2"><visual><geometry><mesh filename="package://three_r_sim/meshes/link2.stl" scale=".001 .001 .001"/></geometry></visual><inertial><origin xyz=".055 0 .004"/><mass value=".16"/><inertia ixx=".0004" ixy="0" ixz="0" iyy=".0004" iyz="0" izz=".00015"/></inertial></link>
<link name="link3"><visual><geometry><mesh filename="package://three_r_sim/meshes/link3_penholder.stl" scale=".001 .001 .001"/></geometry></visual><inertial><origin xyz=".035 0 .011"/><mass value=".10"/><inertia ixx=".00016" ixy="0" ixz="0" iyy=".00016" iyz="0" izz=".00007"/></inertial></link>
<joint name="joint1" type="revolute"><parent link="base_link"/><child link="link1"/><origin xyz="0 0 .055"/><axis xyz="0 0 1"/><limit lower="-3.14159" upper="3.14159" effort="1.5" velocity="2"/></joint>
<joint name="joint2" type="revolute"><parent link="link1"/><child link="link2"/><origin xyz=".120 0 .014"/><axis xyz="0 0 1"/><limit lower="-3.14159" upper="3.14159" effort="1" velocity="2"/></joint>
<joint name="joint3" type="revolute"><parent link="link2"/><child link="link3"/><origin xyz=".100 0 .014"/><axis xyz="0 0 1"/><limit lower="-3.14159" upper="3.14159" effort=".5" velocity="2"/></joint>
<link name="pen_tip"/><joint name="pen_tip_fixed" type="fixed"><parent link="link3"/><child link="pen_tip"/><origin xyz=".028 0 -.078"/></joint>
</robot>